# DockerGPT Memory — copy to .env and fill in. .env is git-ignored; never commit it.

# --- Storage (local dev runs on NudgeBee's own compose infra from the repo root) ---
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/dockergpt_memory
QDRANT_URL=http://localhost:6333
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI_URL=http://localhost:8233

# --- NudgeBee: RCA history to seed memory from (same Postgres, NudgeBee's own DB) ---
NUDGEBEE_DB_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/nudgebee

# --- JarvisLabs ---
# Your JarvisLabs API token (jarvislabs.ai > API keys). Used by `python -m scripts.jarvis` and the `jl` CLI.
JL_API_KEY=
# Filled in by `python -m scripts.jarvis up` once the GPU instance is running.
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_API_KEY=
# Optional larger model for the small-vs-large benchmark
LLM_LARGE_BASE_URL=
LLM_LARGE_MODEL=Qwen/Qwen2.5-14B-Instruct

# --- Agent behaviour ---
CONFIDENCE_THRESHOLD=0.6
APPROVAL_TIMEOUT_MIN=15
HEALTH_WINDOW_SEC=25
# Only compose files under this folder can be patched by the agent.
DEMO_ROOT=D:\hacktober\hacktoberfest\demo

# --- Kepler (local SRE agent on this PC) ---
KEPLER_CLI=C:\Users\Raman\Downloads\kepler-cli-x86_64-pc-windows-msvc.exe
KEPLER_HOME=C:\Users\Raman\.kepler
KEPLER_TIMEOUT_SEC=90

# --- Watcher ---
API_URL=http://localhost:8000
# Compose projects the watcher ignores (our own infra)
IGNORE_PROJECTS=nudgebee
# Empty = watch every other project
WATCH_PROJECTS=

# --- Approval channel (Person 4 owns Slack) ---
SLACK_WEBHOOK_URL=
PUBLIC_WEB_URL=http://localhost:3000
