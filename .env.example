# DockerGPT Memory — copy to .env and fill in. .env is git-ignored; never commit it.

# The URLs below are for Python run on the host. Under `docker compose up`, the containers
# override DATABASE_URL, QDRANT_URL, TEMPORAL_ADDRESS, API_URL and KEPLER_CLI with in-network values.

# --- Storage ---
# Password for our compose Postgres (user postgres, host port 5433). Keep it equal to the one in DATABASE_URL.
POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/dockergpt_memory
QDRANT_URL=http://localhost:6333
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI_URL=http://localhost:8233

# --- NudgeBee: RCA history to seed memory from (same Postgres, NudgeBee's own DB) ---
NUDGEBEE_DB_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/nudgebee

# --- JarvisLabs ---
# Your JarvisLabs API token (jarvislabs.ai > API keys). Used by `python -m scripts.jarvis` and the `jl` CLI.
JL_API_KEY=
# Filled in by `python -m scripts.jarvis up` once the GPU instance is running.
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_API_KEY=
# Optional larger model for the small-vs-large benchmark
LLM_LARGE_BASE_URL=
LLM_LARGE_MODEL=Qwen/Qwen2.5-14B-Instruct

# --- Agent behaviour ---
CONFIDENCE_THRESHOLD=0.7
APPROVAL_TIMEOUT_MIN=15
HEALTH_WINDOW_SEC=25
# Only compose files under this folder can be patched by the agent. Absolute host path;
# on EC2: /home/ubuntu/hacktoberfest/demo (the worker mounts it at the same path).
DEMO_ROOT=D:\hacktober\hacktoberfest\demo

# --- Kepler (local SRE agent on this PC) ---
KEPLER_CLI=C:\Users\Raman\Downloads\kepler-cli-x86_64-pc-windows-msvc.exe
KEPLER_HOME=C:\Users\Raman\.kepler
KEPLER_TIMEOUT_SEC=90

# --- Watcher ---
API_URL=http://localhost:8000
# Compose projects the watcher ignores (our own infra)
IGNORE_PROJECTS=nudgebee
# Empty = watch every other project
WATCH_PROJECTS=

# --- Approval channel (Person 4 owns Slack) ---
SLACK_WEBHOOK_URL=
# Link used in Slack messages. On AWS: https://<elastic-ip-with-dashes>.sslip.io
PUBLIC_WEB_URL=http://localhost:3000

# --- Kepler power metrics (optional; empty unless a Kepler exporter runs on the host) ---
KEPLER_URL=
KEPLER_METRIC=

# --- Web (Person 2), baked in at image build time ---
# API base URL for the browser. On AWS leave it EMPTY so the browser calls /api on the same origin.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Temporal UI link shown in the web app. On AWS: http://<elastic-ip>:8233 (team IPs only).
NEXT_PUBLIC_TEMPORAL_UI_URL=http://localhost:8233

# --- AWS deploy (Person 3) ---
# Host Caddy serves with automatic HTTPS: the Elastic IP with dashes, e.g. 13-232-1-2.sslip.io
PUBLIC_HOST=localhost

# --- Retrieval benchmark (eval/bench.py) ---
# Comma-separated embedding models, all served at EMBED_BASE_URL. Empty = EMBED_MODEL only.
BENCH_EMBED_MODELS=
# Comma-separated chat models for --judge. LLM_LARGE_MODEL is called at LLM_LARGE_BASE_URL. Empty = LLM_MODEL,LLM_LARGE_MODEL.
BENCH_LLM_MODELS=
